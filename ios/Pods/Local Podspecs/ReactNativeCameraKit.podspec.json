{
  "name": "ReactNativeCameraKit",
  "version": "18.0.1",
  "summary": "A high performance, fully featured, rock solid camera library for React Native applications",
  "license": "MIT",
  "authors": "CameraKit",
  "homepage": "https://github.com/teslamotors/react-native-camera-kit",
  "platforms": {
    "ios": "15.0"
  },
  "source": {
    "git": "https://github.com/teslamotors/react-native-camera-kit.git",
    "tag": "v18.0.1"
  },
  "source_files": [
    "ios/ReactNativeCameraKit/*.{m,swift,mm}",
    "ios/generated/rncamerakit_specs/*.{m,mm,cpp}"
  ],
  "private_header_files": "ios/ReactNativeCameraKit/ReactNativeCameraKit-Swift.pre.h",
  "compiler_flags": "-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1 -Wno-comma -Wno-shorten-64-to-32",
  "dependencies": {
    "React-Core": [],
    "RCT-Folly": [
      "2024.11.18.00"
    ],
    "glog": [],
    "React-RCTFabric": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "ReactCommon/turbomodule/bridging": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "DoubleConversion": [],
    "hermes-engine": []
  },
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/boost\" \"$(PODS_ROOT)/Headers/Private/Yoga\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1 -Wno-comma -Wno-shorten-64-to-32",
    "OTHER_SWIFT_FLAGS": "$(inherited)"
  }
}
